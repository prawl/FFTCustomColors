{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sharedThemes",
    "jobClasses"
  ],
  "properties": {
    "sharedThemes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      }
    },
    "jobClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "displayName",
          "spriteName",
          "jobType",
          "gender",
          "defaultTheme"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "spriteName": {
            "type": "string",
            "minLength": 1
          },
          "jobType": {
            "type": "string",
            "minLength": 1
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female",
              "male",
              "female"
            ]
          },
          "defaultTheme": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "jobSpecificThemes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]+$"
            }
          },
          "excludedThemes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]+$"
            }
          },
          "texFiles": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
