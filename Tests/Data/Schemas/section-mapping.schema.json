{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "sections"
  ],
  "properties": {
    "_comment": {
      "type": "string"
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "sprite": {
      "type": "string",
      "minLength": 1
    },
    "sprites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "displayName",
          "indices",
          "roles"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "indices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            }
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "base",
                "shadow",
                "highlight",
                "outline",
                "accent",
                "accent_shadow",
                "dark",
                "midtone"
              ]
            }
          },
          "linkedTo": {
            "type": "string"
          },
          "primaryIndex": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "shadeMode": {
            "type": "string",
            "enum": [
              "preserve",
              "uniformHue"
            ]
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "sprite"
      ]
    },
    {
      "required": [
        "sprites"
      ]
    }
  ]
}
